{
  "name": "DoktorABC Dispensary",
  "version": "1.0.0",
  "source": "src/styles/tokens.css (CSS custom properties); this file mirrors it for tools.",
  "color": {
    "themes": ["light"],
    "tokens": {
      "paper": { "value": "#f3f5f4", "role": "page ground" },
      "surface": { "value": "#fbfcfb", "role": "cards, inputs, header" },
      "sunk": { "value": "#e8ecea", "role": "wells, skeletons, hover fills" },
      "line": { "value": "#d3dad7", "role": "decorative hairlines and card edges" },
      "line-strong": { "value": "#7c8884", "role": "input and secondary button edges", "contrast": { "on": "surface", "ratio": 3.57 } },
      "ink": { "value": "#0e1916", "role": "headings and body", "contrast": { "on": "paper", "ratio": 16.4 } },
      "ink-2": { "value": "#3b4844", "role": "secondary text", "contrast": { "on": "paper", "ratio": 8.73 } },
      "ink-3": { "value": "#5a6763", "role": "captions, meta, placeholders", "contrast": { "on": "paper", "ratio": 5.39 } },
      "ink-on-dark": { "value": "#f3f5f4", "role": "text on ink", "contrast": { "on": "ink", "ratio": 16.4 } },
      "ink-on-dark-2": { "value": "#b5bfbb", "role": "secondary text on ink", "contrast": { "on": "ink", "ratio": 9.52 } },
      "pine": { "value": "#0a5c4e", "role": "the one accent: primary action, links, selection, done", "contrast": { "on": "paper", "ratio": 7.23 } },
      "pine-hover": { "value": "#074a3f", "role": "hover, text on pine-tint" },
      "pine-press": { "value": "#063a32", "role": "pressed" },
      "pine-tint": { "value": "#ddebe6", "role": "selected rows, success tags" },
      "pine-wash": { "value": "#eef5f2", "role": "accent wells" },
      "on-pine": { "value": "#fbfcfb", "role": "text on pine", "contrast": { "on": "pine", "ratio": 7.69 } },
      "warn-ink": { "value": "#7a4d00", "role": "pending, low stock text", "contrast": { "on": "warn-tint", "ratio": 6.25 } },
      "warn-tint": { "value": "#f8edd3", "role": "pending, low stock fill" },
      "danger": { "value": "#a8281f", "role": "destructive button, error edge", "contrast": { "on": "surface", "ratio": 6.83 } },
      "danger-ink": { "value": "#8c1f18", "role": "error text", "contrast": { "on": "danger-tint", "ratio": 7.32 } },
      "danger-tint": { "value": "#f7e3e0", "role": "urgent fill" },
      "star": { "value": "#c28e1e", "role": "rating glyph fill only, never text" },
      "focus": { "value": "#0a5c4e", "role": "2 px focus outline, offset 2" }
    },
    "scales": {
      "note": "Tailwind scales in src/index.css. primary, accent, blue, green, purple, indigo, teal and emerald alias pine; yellow, orange alias amber; pink aliases red; neutral, slate alias gray.",
      "gray": ["#f3f5f4", "#e8ecea", "#d3dad7", "#b5bfbb", "#808c88", "#5a6763", "#4a5652", "#3b4844", "#232e2b", "#0e1916"],
      "pine": ["#eef5f2", "#ddebe6", "#bcd7ce", "#8fbbad", "#5a9a88", "#2e7a68", "#0a5c4e", "#074a3f", "#063a32", "#052c26"],
      "amber": ["#fbf5e6", "#f8edd3", "#f0dba6", "#e5c172", "#d9a93f", "#c28e1e", "#9e6f0c", "#7a4d00", "#5e3b00", "#432a00"],
      "red": ["#fbf1ef", "#f7e3e0", "#eec4be", "#e09b92", "#cc6b5f", "#b8443a", "#a8281f", "#8c1f18", "#6e1913", "#50130f"],
      "steps": [50, 100, 200, 300, 400, 500, 600, 700, 800, 900]
    }
  },
  "type": {
    "fonts": {
      "ui": { "family": "Schibsted Grotesk", "package": "@fontsource-variable/schibsted-grotesk", "licence": "OFL-1.1", "weights": "400-800 variable" },
      "data": { "family": "IBM Plex Mono", "package": "@fontsource/ibm-plex-mono", "licence": "OFL-1.1", "weights": [400, 500] }
    },
    "families": {
      "display": "ui",
      "text": "ui",
      "data": "data"
    },
    "scale": {
      "xs": { "size": 12, "line": 16, "use": "mono meta and tags" },
      "sm": { "size": 14, "line": 20, "use": "dense UI, table cells, captions" },
      "base": { "size": 16, "line": 24, "use": "body" },
      "lg": { "size": 18, "line": 26, "use": "lead" },
      "xl": { "size": 22, "line": 28, "use": "card and panel title" },
      "2xl": { "size": 28, "line": 34, "use": "portal page title" },
      "3xl": { "size": 36, "line": 40, "use": "public page title" },
      "4xl": { "size": 48, "line": 52, "use": "landing section display" },
      "5xl": { "size": 60, "line": 62, "use": "landing headline, desktop" }
    },
    "groups": {
      "heading": { "family": "ui", "weight": 600, "tracking": "-0.015em to -0.03em" },
      "body": { "family": "ui", "weight": 400 },
      "control": { "family": "ui", "weight": 500 },
      "label": { "family": "data", "weight": 400, "size": 12, "tracking": "0.02em" },
      "tag": { "family": "data", "weight": 500, "size": 11, "tracking": "0.05em", "case": "upper" },
      "figure": { "family": "data", "weight": 500, "numeric": "tabular-nums" }
    }
  },
  "spacing": {
    "tokens": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96 },
    "gutter": { "phone": 16, "tablet-up": 32 },
    "content-max": 1240,
    "reading-max": "68ch"
  },
  "radius": {
    "tokens": { "tag": 4, "control": 8, "card": 12, "sheet": 16, "full": 9999 },
    "rule": "tags 4, buttons/inputs/menus 8, cards 12, dialogs 16, avatars and toggles full; no pill buttons"
  },
  "shadow": {
    "tokens": {
      "1": "0 1px 2px rgb(14 25 22 / 0.06)",
      "2": "0 1px 2px rgb(14 25 22 / 0.05), 0 4px 12px rgb(14 25 22 / 0.06)",
      "3": "0 2px 4px rgb(14 25 22 / 0.06), 0 16px 40px rgb(14 25 22 / 0.12)"
    },
    "rule": "only floating things: menus, dialogs, toasts, a hovered clickable card"
  },
  "size": {
    "tokens": { "control-sm": 36, "control": 44, "control-lg": 52, "header": 64 }
  },
  "motion": {
    "tokens": { "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)", "fast": "120ms", "base": "220ms" },
    "rule": "press moves 1px; only the skeleton loops; all motion stops under prefers-reduced-motion"
  }
}
